# === Supabase ===
# Aus dem Supabase-Dashboard.
# Project URL: oben auf der Projektseite (Copy-Button).
NEXT_PUBLIC_SUPABASE_URL=
# Settings > API Keys > Publishable key (sb_publishable_...). Oeffentlich, darf in den Browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Settings > API Keys > Secret key (sb_secret_...). Geheim, nur serverseitig, niemals committen.
SUPABASE_SECRET_KEY=

# === LLM / Embeddings ===
# Anbieter deiner Wahl (Gemini, OpenAI, Anthropic ...).
# Der Provider bestimmt auch die Embedding-Dimension in supabase/migrations/0001_init.sql.
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# Kopiere diese Datei zu .env.local und trage deine Werte ein.
# .env.local bleibt lokal und wird NICHT committet.
