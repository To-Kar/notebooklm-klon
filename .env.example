# === Supabase ===
# Aus dem Supabase-Dashboard: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwenden, niemals im Browser exponieren.
SUPABASE_SERVICE_ROLE_KEY=

# === LLM / Embeddings ===
# Anbieter deiner Wahl (Gemini, OpenAI, Anthropic ...).
# Der Provider bestimmt auch die Embedding-Dimension in supabase/migrations/0001_init.sql.
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# Kopiere diese Datei zu .env.local und trage deine Werte ein.
# .env.local bleibt lokal und wird NICHT committet.
